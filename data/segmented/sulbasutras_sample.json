[
  {
    "id": "SHLOKA_250749",
    "text": "समचतुरश्रस्य क्षेत्रफलं भुजवर्गः।।",
    "source": "sulbasutras_sample",
    "chapter": ""
  },
  {
    "id": "SHLOKA_250750",
    "text": "आयतचतुरश्रस्य क्षेत्रफलं दीर्घभुजेन ह्रस्वभुजगुणितम्।।",
    "source": "sulbasutras_sample",
    "chapter": ""
  },
  {
    "id": "SHLOKA_250751",
    "text": "त्रिभुजस्य क्षेत्रफलं भूमिश्चशीर्षलम्बार्धगुणितम्।।",
    "source": "sulbasutras_sample",
    "chapter": ""
  },
  {
    "id": "SHLOKA_250752",
    "text": "वृत्तस्य क्षेत्रफलं व्यासार्धवर्गं पाईगुणितम्।।",
    "source": "sulbasutras_sample",
    "chapter": ""
  },
  {
    "id": "SHLOKA_250753",
    "text": "गोलस्य पृष्ठफलं व्यासवर्गं पाईगुणितम्।।",
    "source": "sulbasutras_sample",
    "chapter": ""
  }
]