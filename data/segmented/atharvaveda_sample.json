[
  {
    "id": "SHLOKA_002266",
    "text": "ज्योतिषां ज्योतिरजरं तदादित्यस्तपति।",
    "source": "atharvaveda_sample",
    "chapter": ""
  },
  {
    "id": "SHLOKA_002267",
    "text": "सूर्यो ग्रहाणां राजा।।",
    "source": "atharvaveda_sample",
    "chapter": ""
  },
  {
    "id": "SHLOKA_002268",
    "text": "चन्द्रमा नक्षत्राणां पतिः शीतलप्रकाशः।",
    "source": "atharvaveda_sample",
    "chapter": ""
  },
  {
    "id": "SHLOKA_002269",
    "text": "रात्रौ प्रकाशयति।।",
    "source": "atharvaveda_sample",
    "chapter": ""
  },
  {
    "id": "SHLOKA_002270",
    "text": "ग्रहाः नवसंख्याकाः सूर्यमण्डलं परिक्रामन्ति।",
    "source": "atharvaveda_sample",
    "chapter": ""
  },
  {
    "id": "SHLOKA_002271",
    "text": "ज्योतिष्यम्।।",
    "source": "atharvaveda_sample",
    "chapter": ""
  },
  {
    "id": "SHLOKA_002272",
    "text": "नक्षत्राणि सप्तविंशतिः चन्द्रमण्डलं परिक्रामन्ति।।",
    "source": "atharvaveda_sample",
    "chapter": ""
  }
]