[
  {
    "id": "SHLOKA_002266",
    "text": "ज्योतिषां ज्योतिरजरं तदादित्यस्तपति।",
    "source": "atharvaveda_sample",
    "chapter": "",
    "veda": "Atharvaveda",
    "domain": "Astronomy",
    "branch": "Jyotisha",
    "keywords": [
      "astronomy",
      "atharvaveda",
      "jyotisha"
    ]
  },
  {
    "id": "SHLOKA_002267",
    "text": "सूर्यो ग्रहाणां राजा।।",
    "source": "atharvaveda_sample",
    "chapter": "",
    "veda": "Atharvaveda",
    "domain": "Unknown",
    "branch": "Unknown",
    "keywords": [
      "atharvaveda"
    ]
  },
  {
    "id": "SHLOKA_002268",
    "text": "चन्द्रमा नक्षत्राणां पतिः शीतलप्रकाशः।",
    "source": "atharvaveda_sample",
    "chapter": "",
    "veda": "Atharvaveda",
    "domain": "Astronomy",
    "branch": "Jyotisha",
    "keywords": [
      "astronomy",
      "atharvaveda",
      "jyotisha"
    ]
  },
  {
    "id": "SHLOKA_002269",
    "text": "रात्रौ प्रकाशयति।।",
    "source": "atharvaveda_sample",
    "chapter": "",
    "veda": "Atharvaveda",
    "domain": "Unknown",
    "branch": "Unknown",
    "keywords": [
      "atharvaveda"
    ]
  },
  {
    "id": "SHLOKA_002270",
    "text": "ग्रहाः नवसंख्याकाः सूर्यमण्डलं परिक्रामन्ति।",
    "source": "atharvaveda_sample",
    "chapter": "",
    "veda": "Atharvaveda",
    "domain": "Mathematics",
    "branch": "Arithmetic",
    "keywords": [
      "mathematics",
      "atharvaveda",
      "arithmetic"
    ]
  },
  {
    "id": "SHLOKA_002271",
    "text": "ज्योतिष्यम्।।",
    "source": "atharvaveda_sample",
    "chapter": "",
    "veda": "Atharvaveda",
    "domain": "Astronomy",
    "branch": "Jyotisha",
    "keywords": [
      "astronomy",
      "atharvaveda",
      "jyotisha"
    ]
  },
  {
    "id": "SHLOKA_002272",
    "text": "नक्षत्राणि सप्तविंशतिः चन्द्रमण्डलं परिक्रामन्ति।।",
    "source": "atharvaveda_sample",
    "chapter": "",
    "veda": "Atharvaveda",
    "domain": "Astronomy",
    "branch": "Jyotisha",
    "keywords": [
      "astronomy",
      "atharvaveda",
      "jyotisha"
    ]
  },
  {
    "id": "SHLOKA_250517",
    "text": "अग्निमीळे पुरोहितं यज्ञस्य देवमृत्विजम्।",
    "source": "rigveda_mandala1",
    "chapter": "",
    "veda": "Rigveda",
    "domain": "Unknown",
    "branch": "Unknown",
    "keywords": [
      "rigveda"
    ]
  },
  {
    "id": "SHLOKA_250518",
    "text": "होतारं रत्नधातमम्।।",
    "source": "rigveda_mandala1",
    "chapter": "",
    "veda": "Rigveda",
    "domain": "Unknown",
    "branch": "Unknown",
    "keywords": [
      "rigveda"
    ]
  },
  {
    "id": "SHLOKA_250519",
    "text": "अग्निः पूर्वेभिरृषिभिरीड्यो नूतनैरुत।",
    "source": "rigveda_mandala1",
    "chapter": "",
    "veda": "Rigveda",
    "domain": "Unknown",
    "branch": "Unknown",
    "keywords": [
      "rigveda"
    ]
  },
  {
    "id": "SHLOKA_250520",
    "text": "स देवाँ एह वक्षति।।",
    "source": "rigveda_mandala1",
    "chapter": "",
    "veda": "Rigveda",
    "domain": "Unknown",
    "branch": "Unknown",
    "keywords": [
      "rigveda"
    ]
  },
  {
    "id": "SHLOKA_250521",
    "text": "अग्निना रयिमश्नवत् पोषमेव दिवेदिवे।",
    "source": "rigveda_mandala1",
    "chapter": "",
    "veda": "Rigveda",
    "domain": "Unknown",
    "branch": "Unknown",
    "keywords": [
      "rigveda"
    ]
  },
  {
    "id": "SHLOKA_250522",
    "text": "यशसं वीरवत्तमम्।।",
    "source": "rigveda_mandala1",
    "chapter": "",
    "veda": "Rigveda",
    "domain": "Unknown",
    "branch": "Unknown",
    "keywords": [
      "rigveda"
    ]
  },
  {
    "id": "SHLOKA_250523",
    "text": "अग्ने यं यज्ञमध्वरं विश्वतः परिभूरसि।",
    "source": "rigveda_mandala1",
    "chapter": "",
    "veda": "Rigveda",
    "domain": "Unknown",
    "branch": "Unknown",
    "keywords": [
      "rigveda"
    ]
  },
  {
    "id": "SHLOKA_250524",
    "text": "स इद्देवेषु गच्छति।।",
    "source": "rigveda_mandala1",
    "chapter": "",
    "veda": "Rigveda",
    "domain": "Unknown",
    "branch": "Unknown",
    "keywords": [
      "rigveda"
    ]
  },
  {
    "id": "SHLOKA_250525",
    "text": "अग्निर्होता कविक्रतुः सत्यश्चित्रश्रवस्तमः।",
    "source": "rigveda_mandala1",
    "chapter": "",
    "veda": "Rigveda",
    "domain": "Unknown",
    "branch": "Unknown",
    "keywords": [
      "rigveda"
    ]
  },
  {
    "id": "SHLOKA_250526",
    "text": "देवो देवेभिरागमत्।।",
    "source": "rigveda_mandala1",
    "chapter": "",
    "veda": "Rigveda",
    "domain": "Unknown",
    "branch": "Unknown",
    "keywords": [
      "rigveda"
    ]
  },
  {
    "id": "SHLOKA_250527",
    "text": "इन्द्रमिद् गाथिनो बृहदिन्द्रमर्केभिरर्किणः।",
    "source": "rigveda_mandala2",
    "chapter": "",
    "veda": "Rigveda",
    "domain": "Unknown",
    "branch": "Unknown",
    "keywords": [
      "rigveda"
    ]
  },
  {
    "id": "SHLOKA_250528",
    "text": "इन्द्रं वाणीरनूषत।।",
    "source": "rigveda_mandala2",
    "chapter": "",
    "veda": "Rigveda",
    "domain": "Unknown",
    "branch": "Unknown",
    "keywords": [
      "rigveda"
    ]
  },
  {
    "id": "SHLOKA_250529",
    "text": "इन्द्र इद्धर्योः सचा समिश्ल आ वचोयुजा।",
    "source": "rigveda_mandala2",
    "chapter": "",
    "veda": "Rigveda",
    "domain": "Unknown",
    "branch": "Unknown",
    "keywords": [
      "rigveda"
    ]
  },
  {
    "id": "SHLOKA_250530",
    "text": "इन्द्रो वज्री हिरण्ययः।।",
    "source": "rigveda_mandala2",
    "chapter": "",
    "veda": "Rigveda",
    "domain": "Unknown",
    "branch": "Unknown",
    "keywords": [
      "rigveda"
    ]
  },
  {
    "id": "SHLOKA_250531",
    "text": "इन्द्र इद्वृत्रहा वसु दाता मघवा पुरुहूतः।",
    "source": "rigveda_mandala2",
    "chapter": "",
    "veda": "Rigveda",
    "domain": "Unknown",
    "branch": "Unknown",
    "keywords": [
      "rigveda"
    ]
  },
  {
    "id": "SHLOKA_250532",
    "text": "इन्द्रः सोमस्य पीतये।।",
    "source": "rigveda_mandala2",
    "chapter": "",
    "veda": "Rigveda",
    "domain": "Unknown",
    "branch": "Unknown",
    "keywords": [
      "rigveda"
    ]
  },
  {
    "id": "SHLOKA_250749",
    "text": "समचतुरश्रस्य क्षेत्रफलं भुजवर्गः।।",
    "source": "sulbasutras_sample",
    "chapter": "",
    "veda": "Unknown",
    "domain": "Mathematics",
    "branch": "Arithmetic",
    "keywords": [
      "mathematics",
      "arithmetic"
    ]
  },
  {
    "id": "SHLOKA_250750",
    "text": "आयतचतुरश्रस्य क्षेत्रफलं दीर्घभुजेन ह्रस्वभुजगुणितम्।।",
    "source": "sulbasutras_sample",
    "chapter": "",
    "veda": "Unknown",
    "domain": "Mathematics",
    "branch": "Arithmetic",
    "keywords": [
      "mathematics",
      "arithmetic"
    ]
  },
  {
    "id": "SHLOKA_250751",
    "text": "त्रिभुजस्य क्षेत्रफलं भूमिश्चशीर्षलम्बार्धगुणितम्।।",
    "source": "sulbasutras_sample",
    "chapter": "",
    "veda": "Unknown",
    "domain": "Mathematics",
    "branch": "Arithmetic",
    "keywords": [
      "mathematics",
      "arithmetic"
    ]
  },
  {
    "id": "SHLOKA_250752",
    "text": "वृत्तस्य क्षेत्रफलं व्यासार्धवर्गं पाईगुणितम्।।",
    "source": "sulbasutras_sample",
    "chapter": "",
    "veda": "Unknown",
    "domain": "Mathematics",
    "branch": "Arithmetic",
    "keywords": [
      "mathematics",
      "arithmetic"
    ]
  },
  {
    "id": "SHLOKA_250753",
    "text": "गोलस्य पृष्ठफलं व्यासवर्गं पाईगुणितम्।।",
    "source": "sulbasutras_sample",
    "chapter": "",
    "veda": "Unknown",
    "domain": "Mathematics",
    "branch": "Arithmetic",
    "keywords": [
      "mathematics",
      "arithmetic"
    ]
  },
  {
    "id": "SHLOKA_250754",
    "text": "एकाधिकेन पूर्वेण।",
    "source": "vedic_mathematics_sutras",
    "chapter": "",
    "veda": "Unknown",
    "domain": "Unknown",
    "branch": "Unknown",
    "keywords": []
  },
  {
    "id": "SHLOKA_250755",
    "text": "इति सूत्रम्।।",
    "source": "vedic_mathematics_sutras",
    "chapter": "",
    "veda": "Unknown",
    "domain": "Unknown",
    "branch": "Unknown",
    "keywords": []
  },
  {
    "id": "SHLOKA_250756",
    "text": "निखिलं नवतश्चरमं दशतः।",
    "source": "vedic_mathematics_sutras",
    "chapter": "",
    "veda": "Unknown",
    "domain": "Unknown",
    "branch": "Unknown",
    "keywords": []
  },
  {
    "id": "SHLOKA_250757",
    "text": "गणितसूत्रम्।।",
    "source": "vedic_mathematics_sutras",
    "chapter": "",
    "veda": "Unknown",
    "domain": "Mathematics",
    "branch": "Arithmetic",
    "keywords": [
      "mathematics",
      "arithmetic"
    ]
  },
  {
    "id": "SHLOKA_250758",
    "text": "ऊर्ध्वतिर्यग्भ्याम्।",
    "source": "vedic_mathematics_sutras",
    "chapter": "",
    "veda": "Unknown",
    "domain": "Unknown",
    "branch": "Unknown",
    "keywords": []
  },
  {
    "id": "SHLOKA_250759",
    "text": "वर्गणासूत्रम्।।",
    "source": "vedic_mathematics_sutras",
    "chapter": "",
    "veda": "Unknown",
    "domain": "Unknown",
    "branch": "Unknown",
    "keywords": []
  },
  {
    "id": "SHLOKA_250760",
    "text": "परावर्त्य योजयेत्।",
    "source": "vedic_mathematics_sutras",
    "chapter": "",
    "veda": "Unknown",
    "domain": "Unknown",
    "branch": "Unknown",
    "keywords": []
  },
  {
    "id": "SHLOKA_250761",
    "text": "भागसूत्रम्।।",
    "source": "vedic_mathematics_sutras",
    "chapter": "",
    "veda": "Unknown",
    "domain": "Unknown",
    "branch": "Unknown",
    "keywords": []
  },
  {
    "id": "SHLOKA_250762",
    "text": "शून्यं साम्यसमुच्चये।",
    "source": "vedic_mathematics_sutras",
    "chapter": "",
    "veda": "Unknown",
    "domain": "Mathematics",
    "branch": "Arithmetic",
    "keywords": [
      "mathematics",
      "arithmetic"
    ]
  },
  {
    "id": "SHLOKA_250763",
    "text": "समीकरणसूत्रम्।।",
    "source": "vedic_mathematics_sutras",
    "chapter": "",
    "veda": "Unknown",
    "domain": "Mathematics",
    "branch": "Arithmetic",
    "keywords": [
      "mathematics",
      "arithmetic"
    ]
  },
  {
    "id": "SHLOKA_250764",
    "text": "आनुरूप्येण।",
    "source": "vedic_mathematics_sutras",
    "chapter": "",
    "veda": "Unknown",
    "domain": "Unknown",
    "branch": "Unknown",
    "keywords": []
  },
  {
    "id": "SHLOKA_250765",
    "text": "अनुपातसूत्रम्।।",
    "source": "vedic_mathematics_sutras",
    "chapter": "",
    "veda": "Unknown",
    "domain": "Unknown",
    "branch": "Unknown",
    "keywords": []
  },
  {
    "id": "SHLOKA_250766",
    "text": "संकलनव्यवकलनाभ्याम्।",
    "source": "vedic_mathematics_sutras",
    "chapter": "",
    "veda": "Unknown",
    "domain": "Unknown",
    "branch": "Unknown",
    "keywords": []
  },
  {
    "id": "SHLOKA_250767",
    "text": "परिकलनसूत्रम्।।",
    "source": "vedic_mathematics_sutras",
    "chapter": "",
    "veda": "Unknown",
    "domain": "Unknown",
    "branch": "Unknown",
    "keywords": []
  },
  {
    "id": "SHLOKA_250768",
    "text": "पूरणापूरणाभ्याम्।",
    "source": "vedic_mathematics_sutras",
    "chapter": "",
    "veda": "Unknown",
    "domain": "Unknown",
    "branch": "Unknown",
    "keywords": []
  },
  {
    "id": "SHLOKA_250769",
    "text": "पूर्णसूत्रम्।।",
    "source": "vedic_mathematics_sutras",
    "chapter": "",
    "veda": "Unknown",
    "domain": "Unknown",
    "branch": "Unknown",
    "keywords": []
  },
  {
    "id": "SHLOKA_250770",
    "text": "चलनकलनाभ्याम्।",
    "source": "vedic_mathematics_sutras",
    "chapter": "",
    "veda": "Unknown",
    "domain": "Unknown",
    "branch": "Unknown",
    "keywords": []
  },
  {
    "id": "SHLOKA_250771",
    "text": "गतिसूत्रम्।।",
    "source": "vedic_mathematics_sutras",
    "chapter": "",
    "veda": "Unknown",
    "domain": "Unknown",
    "branch": "Unknown",
    "keywords": []
  },
  {
    "id": "SHLOKA_250772",
    "text": "यावदूनं तावदूनं।",
    "source": "vedic_mathematics_sutras",
    "chapter": "",
    "veda": "Unknown",
    "domain": "Unknown",
    "branch": "Unknown",
    "keywords": []
  },
  {
    "id": "SHLOKA_250773",
    "text": "न्यूनतासूत्रम्।।",
    "source": "vedic_mathematics_sutras",
    "chapter": "",
    "veda": "Unknown",
    "domain": "Unknown",
    "branch": "Unknown",
    "keywords": []
  }
]